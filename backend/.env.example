# .env.example - Copy to .env and fill in your values

# Secret key for JWT token signing (generate a strong random string)
# On Linux/Mac: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT token expiry in hours (default: 8)
ADMIN_JWT_EXPIRY_HOURS=8

# Secret for QR token HMAC signing (generate a strong random string)
QR_TOKEN_SECRET=your-qr-secret-change-in-production

# Database URL (default: SQLite at data/freshers.db)
# DATABASE_URL=sqlite:///./data/freshers.db
